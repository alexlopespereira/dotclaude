.env
.env.local
.env.*.local

# macOS
.DS_Store

# Claude Code local runtime — research outputs, plans saved during sessions,
# and per-project state. The repo only versions the source-of-truth files
# under skills/, commands/, hooks/, agents/.
.claude/

# telemetry/ é versionada DE PROPÓSITO — NÃO listar aqui, NÃO gitignorar.
# A telemetria DoD/test-spec é escrita per-máquina em ~/.claude/telemetry/.
# O Stop hook hooks/sync-telemetry-log.sh copia esse log da máquina para
# repo/telemetry/ e o stageia (plano M8 / Adv #1): git é o transporte/backup
# cross-máquina. O consumidor bin/lib/usage-fold.sh lê SÓ ~/.claude/telemetry/,
# nunca a cópia do repo — por isso versionar telemetry/ é seguro e intencional.

# Ralph Adversarial framework artifacts — must never be versioned.
# Worker writes these to its slot WT; orchestrator stashes them via
# stash_worker_deltas (lib/dispatch.sh) and integrates into central
# progress.txt / AGENTS.md at merge time. See IMPL_PROMPT.md "CONTRATO
# DE WORKER PARALELO" for the rationale (Codex review WT must not see
# them, history stays free of framework noise).
progress-*.txt
progress-*.jsonl
agents-delta-*.md

# Ralph orchestrator stash dir + ephemeral review worktrees.
.ralph/
.ralph-review-*/

# Per-project Ralph execution artifacts (lived briefly in this repo
# during Fase 2 self-execution; should never be re-committed here —
# dotclaude is the framework, not a target project).
prd.json
progress.txt
progress.jsonl
AGENTS.md

# Playwright MCP runtime artifacts (snapshots, console logs, traces)
# created when browser-actions skill exercises the browser via MCP.
# Per-session, regenerated on demand — never commit.
.playwright-mcp/

# Scratch / dados locais não-versionados (ex.: exports temporários)
temp/
