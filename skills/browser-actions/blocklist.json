    "comprar",
    "purchase",
    "subscribe",
    "assinar",
    "publish",
    "publicar",
    "post",
    "postar",
    "send",
    "enviar",
    "make public",
    "tornar público",
    "transfer",
    "transferir",
    "withdraw",
    "sacar",
    "confirm purchase"
  ],
  "payment_form_inputs": [
    "cardnumber",
    "cvv",
    "cvc",
    "cc-number"
